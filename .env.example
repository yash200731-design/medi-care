# ==============================================================================
# MediVault Environment Configuration
# ==============================================================================

# Application Mode: Set to "true" for synthetic local demo mode (zero setup needed)
NEXT_PUBLIC_DEMO_MODE=true

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Optional in DEMO_MODE; required for live cloud DB)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=medical-records

# ------------------------------------------------------------------------------
# Blockchain / Hardhat Configuration (Optional in DEMO_MODE; required for live RPC)
# ------------------------------------------------------------------------------
# Local Hardhat Node RPC or Sepolia Testnet RPC
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Deployed MediVaultAudit contract address
NEXT_PUBLIC_MEDIVAULT_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Server-side Relayer Private Key (SERVER-SIDE ONLY - for submitting audit transactions)
BLOCKCHAIN_RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
